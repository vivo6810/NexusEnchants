<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
    NexusEnchants Checkstyle rules.

    Deliberately limited to rules that catch objective defects (unused imports,
    silent catch blocks, statements crammed on one line, debug printing) so that
    the build never fails for a subjective formatting preference.
    Formatting-only findings are reported as "info" and do not fail the build.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <module name="NewlineAtEndOfFile"/>
    <module name="FileTabCharacter"/>
    <module name="LineLength">
        <property name="severity" value="info"/>
        <property name="max" value="140"/>
    </module>

    <!-- Debug leftover / accidental console output. The server logger must be used instead. -->
    <module name="RegexpSingleline">
        <property name="format" value="System\.(out|err)\s*\.\s*print"/>
        <property name="message" value="Use the plugin logger instead of System.out/System.err."/>
    </module>
    <module name="RegexpSingleline">
        <property name="format" value="\.printStackTrace\(\)"/>
        <property name="message" value="Log the exception instead of calling printStackTrace()."/>
    </module>
    <module name="RegexpSingleline">
        <property name="format" value="[ \t]+$"/>
        <property name="message" value="Trailing whitespace."/>
    </module>

    <module name="TreeWalker">
        <module name="AvoidStarImport"/>
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>
        <module name="EmptyCatchBlock">
            <property name="exceptionVariableName" value="expected|ignored"/>
        </module>
        <module name="NeedBraces"/>
        <module name="OneStatementPerLine"/>
        <module name="MissingSwitchDefault"/>
        <module name="EqualsHashCode"/>
        <module name="WhitespaceAfter">
            <property name="tokens" value="COMMA, SEMI"/>
        </module>
        <module name="UpperEll"/>
        <module name="ArrayTypeStyle"/>
        <module name="ModifierOrder"/>
    </module>
</module>
